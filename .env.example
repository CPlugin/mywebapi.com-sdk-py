# CPlugin WebAPI Python SDK — example environment.
# Copy to `.env` (gitignored) and fill in your credentials:  cp .env.example .env

# --- Environment (staging is the safe default) ---
# The SDK selects an environment by name; for the examples/e2e you pass
# env="staging" (or "prod") in code. These vars feed the example scripts.

# --- Credentials (required) ---
# Create and manage API keys in the Toolbox (https://toolbox.cplugin.com for prod,
# https://pre.toolbox.cplugin.com for staging).
WEBAPI_CLIENT_ID=your-client-id
WEBAPI_CLIENT_SECRET=your-client-secret

# --- Optional ---
# Trade platform GUID. Created and managed in the Toolbox. Leave empty and run
# `python examples/01_hello.py` to list the platforms your credentials can access.
WEBAPI_TRADE_PLATFORM=

# --- End-to-end tests (opt-in) ---
# Set WEBAPI_E2E=1 together with the credentials above to run the gated e2e
# suite against staging:  WEBAPI_E2E=1 python -m pytest e2e -q
WEBAPI_E2E=
